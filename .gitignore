# Project / Tools
.codex/

# Local case-law acquisition and generated analysis.  These files are
# reproducible inputs/derivatives and must stay outside the public repository.
downloaded_cases/
downloaded_opinions/
build/
logs/


# brainstorming files / examples for codex
brainstorming/
clickable_prototype.js

# Private / generated legal content
# Organization-specific templates must never be committed to this public repo.
# private-content/ (now a submodule)
content/original_templates/
# Only the public filing templates generated from content/filing-templates/
# by `manage.py build_filing_templates` are committed, each named explicitly so
# a private package copied here is still ignored.
content/document-templates/*
!content/document-templates/motion-for-summary-judgment/
!content/document-templates/motion-to-dismiss/
!content/document-templates/reply-in-support-of-motion-for-summary-judgment/
!content/document-templates/reply-in-support-of-motion-to-dismiss/
content/docx-snippets/*/
!content/docx-snippets/_shared/
!content/docx-snippets/motion-for-summary-judgment/
!content/docx-snippets/motion-to-dismiss/
!content/docx-snippets/reply-in-support-of-motion-for-summary-judgment/
!content/docx-snippets/reply-in-support-of-motion-to-dismiss/
# content/treatises/ (now a submodule)
# The ordinance corpus is generated, unversioned data: municipality directories
# are written by scripts/ingest_local_ordinances.py and the inbox holds the
# source documents they were read from. Both live on the storage share, like
# case-law bundles. What stays here is what a person maintains and reviews:
# the coverage scope, the cross-city datasets, and the supplied transcriptions
# that scope.yaml points at.
content/ordinances/*
!content/ordinances/README.md
!content/ordinances/scope.yaml
!content/ordinances/datasets/
!content/ordinances/_transcriptions/
# The learned term-neighbour table research mode expands queries with. It is
# generated by `manage.py build_research_index` from corpus co-occurrence, and
# it is derived from the imported case-law corpus as well as from this library,
# so one deployment's table is the wrong answer in another. What stays in git is
# what a person maintains: the thesaurus, the district map, and the
# known-answer queries.
content/research-index/term-neighbors.json

ssh/

docs/slides

# Real client briefs used for local CLE / testing — named by client surname,
# never commit.
cle_real_briefs/

# Licensed Lexis briefs and their generated experiment artifacts.  The source
# documents may be proprietary and the results include large local databases.
lexis_real_briefs/
