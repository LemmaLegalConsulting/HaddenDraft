DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_SITE_URL=http://localhost:5173

# Set to true only when a reverse proxy that terminates TLS sits in front of the
# app (Azure Container Apps ingress, nginx-proxy, App Gateway). Django then
# reads X-Forwarded-Proto to decide whether a request arrived over HTTPS. A
# client can forge that header, so leaving this false when there is no proxy is
# what keeps it trustworthy.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Database. Leave POSTGRES_HOST unset to use the local SQLite database.
# POSTGRES_HOST=
# POSTGRES_DB=agentic_housing
# POSTGRES_USER=agentic_housing
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# Managed servers such as Azure Flexible Server require TLS; use "require"
# there. The "prefer" default suits a Postgres container on a private network.
# POSTGRES_SSLMODE=prefer

# OpenAI-compatible endpoint. Azure OpenAI v1-compatible endpoints work here.
OPENAI_BASE_URL=https://example.openai.azure.com/openai/v1/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DRAFTING_ENABLED=false

# Research is always constrained to a jurisdiction. This is the organization
# fallback; a Django-admin setting or individual user profile can override it.
DEFAULT_JURISDICTION=Ohio

# Repository content library. Keep the default for local development; a future
# admin-selected SharePoint provider will use the same logical layout.
CONTENT_LIBRARY_DIR=content
ORGANIZATION_CONTENT_LIBRARY_DIR=private-content

# Side-loaded document storage: case-law PDFs and private organization content.
# Every store is split into two areas (see apps.core.storage):
#
#   raw/        what you upload. Source material, nothing serves from here.
#   published/  what the app reads and serves, written by an ingest/publish step.
#
# "filesystem" points at a directory or a mounted file share. "s3" targets any
# S3-compatible endpoint (AWS, Cloudflare R2, Backblaze B2, MinIO) and needs
# boto3 installed plus a bucket and keys; switching stores is config, not code.
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_ROOT=private-content/storage
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_ACCESS_KEY_ID=
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_REGION=

# Key prefixes within each area.
CASELAW_STORAGE_PREFIX=caselaw
PRIVATE_CONTENT_STORAGE_PREFIX=private-content
CASELAW_IMPORT_REQUIRE_VERIFIED=false
CASELAW_IMPORT_APPROVE_VERIFIED_FOR_SEARCH=true
CASELAW_IMPORT_APPROVE_UNVERIFIED_FOR_SEARCH=false

# LegalServer instance API settings. Paths are configurable because instances vary.
LEGALSERVER_BASE_URL=https://your-site.legalserver.org
LEGALSERVER_API_TOKEN=
LEGALSERVER_MATTERS_PATH=/api/v2/matters
LEGALSERVER_MATTERS_RESULTS=full
LEGALSERVER_MATTER_DOCUMENTS_PATH=/api/v1/matters/{matter_id}/documents
LEGALSERVER_MATTER_PROFILE_PATH=/matter/dynamic-profile/view/{matter_id}
LEGALSERVER_USER_FILTER_PARAM=assigned_user_email

# Microsoft Graph / SharePoint Online settings.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ACCESS_TOKEN=
SHAREPOINT_CASE_FOLDER_TEMPLATE=Cases/{matter_id}

# Office 365 sign-in and delegated Microsoft Graph access.
# Use "organizations" for any work/school Office 365 tenant, or a tenant ID for one tenant only.
OFFICE365_TENANT_ID=organizations
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_REDIRECT_URI=http://localhost:5173/api/auth/office365/callback/
OFFICE365_SCOPES=openid profile email offline_access User.Read Sites.Read.All Files.Read.All

# Use Django RemoteUserMiddleware when Office 365 SSO is terminated upstream.
ENABLE_REMOTE_USER_AUTH=false
